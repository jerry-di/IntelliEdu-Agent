# ══════════════════════════════════════════════════════════════
# EduAgent 环境变量模板
# 使用方法：复制本文件为 .env.local 并填入真实值
#   cp .env.example .env.local
# ══════════════════════════════════════════════════════════════

# ===== 数据库（PostgreSQL）=====
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent
DB_USER=eduagent_user
DB_PASSWORD=change_me

# ===== Milvus 向量库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19531

# ===== DeepSeek 大模型（必填）=====
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash
DEEPSEEK_MODEL_CODER=deepseek-v4-flash

# ===== 本地模型路径 =====
RERANKER_MODEL_PATH=./models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=./models/classifier/all-MiniLM-L6-v2
FINETUNED_CLASSIFIER_PATH=./models/classifier/query-classifier-finetuned
BGE_M3_MODEL_PATH=./models/embedding/bge-m3

# ===== JWT 认证（必填，请用随机字符串）=====
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== MCP 服务地址（默认即可）=====
KB_MCP_SERVER_URL=http://localhost:8000/mcp/kb
WEB_SEARCH_MCP_URL=http://localhost:8000/mcp/web-search

# ===== 可选第三方模型（留空则不启用）=====
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.cubence.com

# ===== Web 搜索（可选，留空则用免费的 DuckDuckGo）=====
TAVILY_API_KEY=

# ===== 应用配置 =====
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default
